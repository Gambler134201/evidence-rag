# evidence-rag 环境变量样例：只含变量名与说明，不含真实值。
# 复制为 .env 并填入本机真实值；.env 已被 .gitignore 排除，不入库。

# ── 生成模型（已确认：用户本地自部署，OpenAI 兼容接口，无密钥）──
GENERATION_BASE_URL=            # 例如 https://<内网或 tailnet 主机>/v1（不以 /chat/completions 结尾）
GENERATION_MODEL=               # 例如 qwen3.8-flash-next-iq3_xxs（以 /v1/models 返回为准）
GENERATION_API_KEY=             # 本地部署无密钥，留空；接入托管服务时填写

# ── Embedding（待选型后填写：本地部署 bge-m3 或云端 API，见 docs/model-and-cost.md）──
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=            # 如 bge-m3 为 1024；启动时与索引配置校验一致

# ── PostgreSQL（docker-compose.yml 的 db 服务；本项目专用实例）──
POSTGRES_USER=evidence_rag
POSTGRES_PASSWORD=              # 必填（compose 中使用 ${POSTGRES_PASSWORD:?}，未设置将拒绝启动）
POSTGRES_DB=evidence_rag
POSTGRES_PORT=5432

# ── 真实模型调用开关（S1-T11）：默认 0，测试全部走 mock；置 1 才发起真实调用 ──
ENABLE_REAL_MODEL_CALLS=0

# 检索模式：vector（默认基线）| rerank（B3 验证 dev 集 87.9%，需 Embedding 提供方支持 /rerank）
RETRIEVAL_MODE=vector

# 检索阈值（可选；不用时整行注释——空字符串会导致 pydantic 校验失败。校准方法见 evals/results/min-score-calibration.md）
# RETRIEVAL_REFUSE_SCORE=0.45
# RETRIEVAL_WARN_SCORE=0.62
# 注意：不留空值——空字符串会导致 pydantic 校验失败；不用时请整行注释
